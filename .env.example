# ─────────────────────────────────────────────────────────────
# Environment variables for the app. Copy to `.env` and fill in.
#   cp .env.example .env
# NEXT_PUBLIC_* values are built into the browser bundle when
# `next dev` / `next build` starts — restart after changing them,
# and never put a secret in one.
# ─────────────────────────────────────────────────────────────


# ─── Database (Prisma) ─── REQUIRED ───────────────────────────
# App + CLI connection. Local Postgres or your hosted database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/venuscorporation?schema=public"
# Only when DATABASE_URL goes through a connection pooler (e.g. Supabase
# port 6543): a direct connection for migrations. See prisma.config.ts.
DIRECT_URL=""


# ─── Supabase (login, sessions, image storage) ─── REQUIRED ──
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# The "anon" / "public" key. NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""


# ─── Site URLs ─── REQUIRED ───────────────────────────────────
# Public address of the site, no trailing slash. Used for SEO metadata,
# auth redirect links (sign-up confirmation, Google login) and payment redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Base URL for links inside emails. Usually the same as NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── Email (Resend) ─── REQUIRED ──────────────────────────────
# https://resend.com/api-keys. The payment callback fails to load without it.
RESEND_API_KEY=""
# Sender for confirmation emails; the domain must be verified in Resend.
# Empty = "Marathon Events <info@merchcommunication.com>".
RESEND_ORDER_CONFIRMATION_FROM_EMAIL=""


# ─── Payments (ShurjoPay) ─── REQUIRED for checkout ──────────
# Sandbox: https://sandbox.shurjopayment.com  (test credentials from ShurjoPay)
# Live:    https://engine.shurjopayment.com
# No trailing slash.
SHURJOPAY_API_URL="https://sandbox.shurjopayment.com"
SHURJOPAY_USERNAME=""
SHURJOPAY_PASSWORD=""
# Must reach this app: http://localhost:3000/... locally, your domain in production.
SHURJOPAY_CALLBACK_URL="http://localhost:3000/api/payment/shurjopay/callback"
# Order-id prefix given by ShurjoPay (defaults to "RRN").
SHURJOPAY_PREFIX=""


# ─── SMS ─── optional (confirmation texts) ────────────────────
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""


# ─── Analytics ─── optional ───────────────────────────────────
# Leave empty to turn tracking off (recommended locally).
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
# Long random string. Keeps unique-visitor counts stable across restarts.
#   openssl rand -hex 32
PAGEVIEW_SALT=""


# ─── Image uploads (own CDN) ─── optional ────────────────────
# Folder on the server where uploads are written (default /var/www/cdn/images)
# and the public URL that serves it (default https://assets.merchcommunication.com).
CDN_ROOT=""
NEXT_PUBLIC_CDN_URL=""


# ─── Seed (prisma/seed.ts) ─── optional ──────────────────────
# Your Supabase login email: the seeded ADMIN gets this email, so logging in
# makes you admin. Defaults to admin@merchsports.test.
SEED_ADMIN_EMAIL=""

# ─── Cloudinary (photo uploads with ImageUploadCloudinary) ───
# Dashboard → Settings → API Keys. The secret is only used on the server.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: top folder for every upload (default "venuscorporation")
CLOUDINARY_FOLDER="venuscorporation"
